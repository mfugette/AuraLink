# ── eBay Browse API ──────────────────────────────────────────────────────────
# Create a developer account at https://developer.ebay.com and create an app
# to get these credentials. Use the Production keys (not Sandbox) for live data.
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret

# ── Supabase ──────────────────────────────────────────────────────────────────
# From Supabase Dashboard → Project Settings → API.
# SUPABASE_URL: the Project URL.
# SUPABASE_SERVICE_ROLE_KEY: the service_role secret — SERVER ONLY, bypasses RLS.
#   Never expose this in the Angular client or commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Maps Platform ──────────────────────────────────────────────────────
# Powers the nearby-services finder (mechanics, tow, tire, auto parts).
# Enable "Geocoding API" and "Places API (New)" in Google Cloud Console.
# This SERVER key should be restricted to those two APIs. Keep it server-only.
GOOGLE_MAPS_API_KEY=your-google-maps-server-key

# ── Google Gemini (Aura AI assistant) ──────────────────────────────────────────
# From Google AI Studio (https://aistudio.google.com/apikey) or a Google Cloud
# project with the Generative Language API enabled. Server-only — never expose
# in the Angular client.
GEMINI_API_KEY=your-gemini-api-key

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
CLIENT_ORIGIN=http://localhost:4200

# ── Notifications (optional) ──────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMTP_FROM=
